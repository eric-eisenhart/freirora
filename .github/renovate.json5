{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':enablePreCommit',
  ],
  rebaseWhen: 'auto',
  dependencyDashboard: {
    autoclose: true,
  },
  packageRules: [
    {
      abandonmentThreshold: '5 years',
      matchPackageNames: [
        '*',
      ],
    },
    {
      automerge: true,
      matchUpdateTypes: [
        'pin',
        'pinDigest',
      ],
    },
    {
      automerge: true,
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        'actions/**',
        'github/**',
        'docker/**',
        'sigstore/**',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
    },
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/ublue-os/bazzite',
      ],
      pinDigests: false,
    },
    {
      enabled: false,
      matchUpdateTypes: [
        'digest',
        'pinDigest',
        'pin',
      ],
      matchDepTypes: [
        'container',
      ],
      matchFileNames: [
        '.github/workflows/**.yaml',
        '.github/workflows/**.yml',
      ],
    },
    {
      enabled: false,
      matchUpdateTypes: [
        'digest',
        'pinDigest',
      ],
      matchFileNames: [
        'Containerfile',
      ],
    },
  ],
}
